rules_version = '2';
service cloud_firestore {
  match /databases/{database}/documents {
    // Partidas terminadas: cada jugador escribe las suyas una vez y no se tocan más.
    match /runs/{runId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.turns is int
        && request.resource.data.choices.size() <= 200;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
