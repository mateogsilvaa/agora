rules_version = '2';

// Ágora · reglas de Firestore
//
// users/{uid}                         perfil + premium + lista de grupos (límite: 1 sin premium)
// invites/{code}                      código de invitación → groupId
// groups/{gid}                        la cámara (solo premium puede crearla)
//   members/{uid}                     escaños y partido de cada miembro
//   parties/{pid}                     partidos (leaderId = portavoz)
//   coalitions/{cid}                  pactos entre partidos (signed = uids de portavoces que firman)
//   votes/{vid}                       votaciones
//     ballots/{bid}                   papeletas (bid = uid si es nominal; aleatorio si es secreta)
//     voters/{uid}                    quién ha votado (una vez por persona)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function onlyChanges(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }

    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function groupLimit(u) { return u.premium == true ? 50 : 1; }

    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function group(gid) { return get(groupPath(gid)).data; }
    function memberPath(gid, uid) { return /databases/$(database)/documents/groups/$(gid)/members/$(uid); }
    function isMember(gid) { return signedIn() && exists(memberPath(gid, me())); }
    function member(gid) { return get(memberPath(gid, me())).data; }
    function isOwner(gid) { return signedIn() && group(gid).ownerId == me(); }

    function validName(s, max) { return s is string && s.size() > 0 && s.size() <= max; }

    // ---------- Usuarios ----------
    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && data().keys().hasOnly(['name', 'email', 'premium', 'groups', 'createdAt'])
        && validName(data().name, 40)
        && data().premium == false
        && data().groups == [];
      // premium solo se cambia desde la consola de Firebase
      allow update: if signedIn() && me() == uid
        && data().premium == resource.data.premium
        && data().groups is list
        && data().groups.size() <= groupLimit(resource.data)
        && validName(data().name, 40);
    }

    // ---------- Invitaciones ----------
    match /invites/{code} {
      // Público: así el enlace de invitación enseña el nombre del grupo antes de crear la cuenta
      allow get: if true;
      allow update: if signedIn() && isOwner(resource.data.groupId) && data().groupId == resource.data.groupId;
      allow create: if signedIn()
        && getAfter(groupPath(data().groupId)).data.ownerId == me()
        && getAfter(groupPath(data().groupId)).data.code == code;
      allow delete: if signedIn() && isOwner(resource.data.groupId);
    }

    // ---------- Grupos ----------
    match /groups/{gid} {
      allow read: if isMember(gid);
      allow create: if signedIn()
        && userDoc(me()).premium == true
        && data().ownerId == me()
        && validName(data().name, 60)
        && data().seatMode in ['member', 'election', 'manual']
        && data().discipline in ['free', 'bloc', 'choose']
        && getAfter(/databases/$(database)/documents/invites/$(data().code)).data.groupId == gid;
      allow update: if isOwner(gid)
        && data().ownerId == resource.data.ownerId
        && data().seatMode in ['member', 'election', 'manual']
        && data().discipline in ['free', 'bloc', 'choose']
        && validName(data().name, 60);
      allow delete: if isOwner(gid);

      // ---------- Miembros ----------
      match /members/{uid} {
        allow read: if isMember(gid);
        // Entrar: con el código del grupo (o siendo el dueño al crearlo) y con hueco en tu cuenta
        allow create: if signedIn() && me() == uid
          && data().keys().hasOnly(['name', 'partyId', 'seats', 'joinedAt', 'code'])
          && validName(data().name, 40)
          && data().partyId == null
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.groups.hasAny([gid])
          && (
            getAfter(groupPath(gid)).data.ownerId == me()
            || (data().code == group(gid).code
                && data().seats == (group(gid).seatMode == 'member' ? 1 : 0))
          );
        // Cada uno cambia su nombre y su partido (sí, se puede ser tránsfuga). Los escaños, el dueño.
        allow update: if (signedIn() && me() == uid && onlyChanges(['name', 'partyId'])
              && (data().partyId == null || exists(/databases/$(database)/documents/groups/$(gid)/parties/$(data().partyId))))
          || (isOwner(gid) && onlyChanges(['seats', 'partyId'])
              && data().seats is int && data().seats >= 0 && data().seats <= 1000);
        allow delete: if signedIn() && (me() == uid || isOwner(gid));
      }

      // ---------- Partidos ----------
      match /parties/{pid} {
        function leaderVoteOk(v) {
          return v.type == 'leader' && v.partyId == pid && v.status == 'closed'
            && v.result != null && v.result.winner == data().leaderId;
        }
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && data().leaderId == me()
          && validName(data().name, 50)
          && validName(data().short, 6);
        allow update: if isMember(gid) && (
            ((resource.data.leaderId == me() || isOwner(gid))
              && validName(data().name, 50)
              && validName(data().short, 6))
            // Relevo de portavoz: cualquier afiliado lo aplica citando la elección interna cerrada
            || (member(gid).partyId == pid
              && onlyChanges(['leaderId', 'leaderVoteId'])
              && leaderVoteOk(get(/databases/$(database)/documents/groups/$(gid)/votes/$(data().leaderVoteId)).data))
          );
        allow delete: if isMember(gid) && (resource.data.leaderId == me() || isOwner(gid));
      }

      // ---------- Coaliciones ----------
      match /coalitions/{cid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && data().createdBy == me()
          && validName(data().name, 60)
          && data().parties is list && data().parties.size() >= 2
          && data().signed == [me()];
        // Firmar o retirar la firma propia
        allow update: if isMember(gid) && onlyChanges(['signed'])
          && (data().signed.toSet().difference(resource.data.signed.toSet()) == [me()].toSet()
              || resource.data.signed.toSet().difference(data().signed.toSet()) == [me()].toSet());
        allow delete: if isMember(gid) && (resource.data.createdBy == me() || isOwner(gid));
      }

      // ---------- El Periódico ----------
      match /news/{nid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && data().by == me()
          && data().kind in ['group_created', 'member_joined', 'member_left', 'party_founded', 'party_dissolved',
                             'party_joined', 'party_left', 'leader_elected', 'coalition_proposed', 'coalition_signed',
                             'vote_opened', 'amendment_tabled', 'vote_result', 'office_appointed', 'seats_allocated', 'live_started'];
        allow delete: if isOwner(gid);
      }

      // ---------- Chats: sala de cada partido y sala de portavoces ----------
      // Los mensajes caducan (expireAt): configura la política TTL en la consola para que se borren solos.
      match /rooms/{room}/messages/{mid} {
        function myParty() { return member(gid).partyId; }
        function amLeader() {
          return myParty() != null
            && exists(/databases/$(database)/documents/groups/$(gid)/parties/$(myParty()))
            && get(/databases/$(database)/documents/groups/$(gid)/parties/$(myParty())).data.leaderId == me();
        }
        function canRoom() {
          return isMember(gid) && (room == 'leaders' ? amLeader() : (myParty() != null && room == 'p_' + myParty()));
        }
        allow read: if canRoom();
        allow create: if canRoom() && data().uid == me()
          && data().text is string && data().text.size() > 0 && data().text.size() <= 500
          && data().expireAt is timestamp && data().expireAt <= request.time + duration.value(8, 'd');
        allow delete: if signedIn() && (resource.data.uid == me() || isOwner(gid));
      }

      // ---------- Votaciones ----------
      match /votes/{vid} {
        function vote() { return get(/databases/$(database)/documents/groups/$(gid)/votes/$(vid)).data; }
        function isOpen(v) { return v.status == 'open' && (v.deadline == null || request.time < v.deadline); }
        function isFinished(v) { return v.status == 'closed' || (v.deadline != null && request.time >= v.deadline); }

        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && data().createdBy == me()
          && validName(data().title, 140)
          && data().type in ['yesno', 'options', 'office', 'bill', 'election', 'leader', 'referendum', 'censure', 'confidence']
          && data().discipline in ['free', 'bloc']
          && (data().type != 'election' || isOwner(gid))
          && (data().type != 'leader' || (data().partyId != null && member(gid).partyId == data().partyId));
        allow update: if isMember(gid) && (resource.data.createdBy == me() || isOwner(gid))
          && data().createdBy == resource.data.createdBy
          && data().type == resource.data.type;
        allow delete: if isMember(gid) && (resource.data.createdBy == me() || isOwner(gid));

        match /voters/{uid} {
          allow read: if isMember(gid);
          allow create: if isMember(gid) && me() == uid
            && existsAfter(/databases/$(database)/documents/groups/$(gid)/votes/$(vid)/ballots/$(data().ballotId));
        }

        match /ballots/{bid} {
          // Secreta: no se ven las papeletas hasta que acaba (y no llevan uid)
          allow read: if isMember(gid) && (vote().secret == false || isFinished(vote()));
          allow create: if isMember(gid)
            && isOpen(vote())
            && !exists(/databases/$(database)/documents/groups/$(gid)/votes/$(vid)/voters/$(me()))
            && getAfter(/databases/$(database)/documents/groups/$(gid)/votes/$(vid)/voters/$(me())).data.ballotId == bid
            && data().partyId == member(gid).partyId
            && data().leader == (member(gid).partyId != null
                && exists(/databases/$(database)/documents/groups/$(gid)/parties/$(member(gid).partyId))
                && get(/databases/$(database)/documents/groups/$(gid)/parties/$(member(gid).partyId)).data.leaderId == me())
            && (vote().type != 'leader' || member(gid).partyId == vote().partyId)
            && (vote().type in ['election', 'leader', 'referendum']
                ? data().weight == 1
                : (data().weight == member(gid).seats && member(gid).seats > 0))
            && (vote().secret == true
                ? !data().keys().hasAny(['uid', 'name'])
                : (bid == me() && data().uid == me()));
        }
      }
    }
  }
}
